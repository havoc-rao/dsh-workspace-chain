{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "paths": {
      "@deepseek-ai/cordis": ["./node_modules/@deepseek-ai/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-session": ["./node_modules/@deepseek-ai/dsh-session/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-session/types": ["./node_modules/@deepseek-ai/dsh-session/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-jobs": ["../../deepseek-harness/packages/jobs/jobs/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-jobs/view": ["../../deepseek-harness/packages/jobs/jobs/lib/types/view.d.ts"],
      "@deepseek-ai/dsh-client-ui-jobs/client": ["../../deepseek-harness/packages/client/ui-jobs/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-slots": [
        "../../deepseek-harness/packages/client/ui-slots/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-conversation/client": [
        "../../deepseek-harness/packages/client/ui-conversation/lib/types/client/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
