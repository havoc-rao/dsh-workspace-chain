{
  "name": "dsh-workspace-chain",
  "version": "0.1.1",
  "description": "Delegate self-contained tasks to fresh host sessions in registered local workspaces through the DSH local API",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./child.patch.yml": "./src/child.patch.yml",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "src/child.patch.yml",
    "cordis.patch.yml",
    "dsh.plugin.json"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.16"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && tsdown",
    "test": "pnpm build && vitest run",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-jobs": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-subagent": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.1"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-timer": "1.1.7-alpha.1",
    "@deepseek-ai/dsh-agent-instructions": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-bash-local": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-fs-local": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-fs-observation-policy": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.2.1-alpha.1",
