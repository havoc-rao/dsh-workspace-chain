    "@deepseek-ai/dsh-llm-retry": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-checkpoint-policy": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-shell-env": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-subagent-dsh-sdk": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-bash": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-jobs": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-storage": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-storage-json": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-workspace": "0.2.1-alpha.1",
    "@havocrao/dsh-code-finder": "link:/Users/havoc/Documents/Projects/tools/DSH-code-finder",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^26.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-approval": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-util-values": "0.2.1-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    }
  }
}
